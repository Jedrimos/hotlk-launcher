{
  "name": "hotlk-launcher",
  "version": "0.5.0",
  "description": "Launcher für Home of the Lich King",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.jedrimos.hotlk.launcher",
    "productName": "HomeOfTheLichKing",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "HomeOfTheLichKing-Launcher.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jedrimos/hotlk-launcher.git"
  }
}
