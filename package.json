{
  "name": "hotlk-launcher",
  "version": "0.6.8",
  "description": "Launcher für Home of the Lich King",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.jedrimos.hotlk.launcher",
    "productName": "HomeOfTheLichKing",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "HomeOfTheLichKing-Setup-${version}.exe",
      "shortcutName": "Home of the Lich King",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jedrimos",
        "repo": "hotlk-launcher"
      }
    ],
    "electronLanguages": [
      "de",
      "en-US"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jedrimos/hotlk-launcher.git"
  },
  "author": "Jedrimos",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
